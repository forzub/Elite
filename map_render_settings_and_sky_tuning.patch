-
-    pose.scale =
-        static_cast<double>(
-            m_galaxyCamera.distance
-        );
-
-    if (!m_galaxyCameraFlight.cancel(
-            snapToDestination,
-            pose
-        ))
-    {
-        return;
-    }
-
-    m_galaxyCamera.target =
