-
-
-    // pos.y — это baseline текста, поэтому учитываем высоту блока.
-    const float gap =
-        std::clamp(static_cast<float>(vp.height) * 0.018f, 14.0f, 24.0f);
-
-    glm::vec2 lineEnd {
-        screen.x + gap,
-        screen.y - gap
-    };
-
-    glm::vec2 textPos {
-        lineEnd.x + 6.0f,
-        lineEnd.y - 4.0f
-    };
-
-    // if (pos.x + w > vp.x + vp.width - 12.0f)
