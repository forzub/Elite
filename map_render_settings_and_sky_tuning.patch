-                overlap = true;
-                break;
-            }
-        }
-
-        if (overlap && !selected)
-            continue;
-
-        occupied.push_back(rect);
-
-
-
-        labels.push_back({
-                s.name,
-                subtitle,
-                screen,
-                lineEnd,
