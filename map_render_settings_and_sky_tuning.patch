-    if (!insideKnownSystem)
-    {
-        const int terminalLevel =
-            m_galaxyNavigationGrid.maximumLevel();
-
-        const auto terminalIndex =
-            m_galaxyNavigationGrid.nearestIndexForPositionLy(
