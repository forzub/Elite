+        Деление на масштаб возвращает её в AU. Это и есть
+        навигационный курсор. Он не зависит от выбранного тела.
+    */
+    return
+        m_systemCamera.target /
+        static_cast<double>(
+            m_lastSystemScale
+        );
+}
