    "hd69830_verde": {
      "why": "далёкий богатый газом мир со слабой промышленностью: оборона газовых платформ, противоастероидная защита кометного облака",
      "roles": [
        "infrastructure_defence",
        "impact_defence",
        "SAR"
      ]
    },
    "hd40307_firmament": {
      "why": "провинция Гармонии в холодной войне с Маланд: база, рой собственного конвоя, обязательство метрополии",
      "roles": [
        "deterrence",
        "alliance_obligation",
