-            5.0f
-        );
-    }
-
-    if (cameraSpaceForWorldPoint(southWorld).z >= 0.0)
-    {
-        const glm::dvec2 south =
-            planetMapProject(
-                southWorld,
-                planet,
-                scale,
-                centerPx
-            );
-
-        drawPlanetMapCross(
-            south,
-            5.0f
-        );
-    }
-}
