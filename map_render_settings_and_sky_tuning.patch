+
+    glColor4f(zColor.r, zColor.g, zColor.b, zColor.a);
+
+    drawPlanetMapLine(
+        origin,
+        hubMapProject(
+            center + axes.z * axisLenMeters,
+            scale,
+            centerPx
+        )
+    );
+}
