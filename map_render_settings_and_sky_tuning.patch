-
-    // if (pos.y - h < vp.y + 12.0f)
-    //     pos.y = screen.y + h + gap;
-
-    // debugLabelTraceToFile(s.name, screen, textPos);
-
-
-
-
-        const glm::vec4 rect {
-            textPos.x,
-            textPos.y - static_cast<float>(px),
