-    function connectWs() {
-      const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
-      state.ws = new WebSocket(`${protocol}//${location.host}`);
-
-      state.ws.addEventListener('open', () => {
-        setStatus('connected');
-        logLine('WebSocket connected');
-
-        state.ws.send(JSON.stringify({
-          type: 'subscribe',
-          panel: 'debug_control',
-          payload: {}
-        }));
-      });
-
-      state.ws.addEventListener('close', () => {
-        setStatus('disconnected');
-        logLine('WebSocket disconnected', 'warn');
-      });
-
-      state.ws.addEventListener('error', () => {
-        setStatus('error');
-        logLine('WebSocket error', 'error');
-      });
-
-      state.ws.addEventListener('message', (event) => {
-      let msg = null;
-
-      try {
-        msg = JSON.parse(event.data);
-      } catch (e) {
-        logLine('Invalid JSON message from engine', 'error');
-        return;
-      }
-
-      if (msg.panel !== 'debug_control') return;
-
-      if (msg.type === 'state_update') {
-        applyPayload(msg.payload || {});
-        return;
-      }
-
-      if (msg.type === 'debug_log') {
-        const p = msg.payload || {};
-        logLine(p.message || '(empty log message)', p.level || 'info');
-        return;
-      }
-
-      if (msg.type === 'performance_update') {
-        applyPerformancePayload(msg.payload || {});
-        return;
-      }
-    });
-    }
-
-    window.app = {
