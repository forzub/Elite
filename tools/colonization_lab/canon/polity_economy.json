  "doctrines": {
    "sol_authority": {
      "why": "300 лет за Кордоном, 11.7 млрд людей и самый густой пояс хабитатов человечества: защита от падения камней на Землю и хабитаты Сола, таможня возвращающейся сети, страх колоний перед её численностью",
      "roles": [
        "impact_defence",
        "customs",
        "deterrence",
        "SAR"
      ]
    },
    "tau_ceti_cognium": {
      "why": "держатель Управления Маяков и тайны ядер прыжка: охрана сети и фабрики ядер, инспекции по лицензиям, сдерживание Цитадели, отказавшейся от инспекций; карантинная блокада поля «Лотоса» (с 3112: официально биоопасность, на деле монополия на лотосит и тайна поля)",
      "roles": [
        "beacon_security",
        "customs",
        "deterrence",
        "strategic_industry",
        "quarantine"
      ]
    },
    "eps_eri_harmony": {
      "why": "пиратский пояс у себя дома и 550 лет тлеющей войны с Варпстанисом; конвои пояса, противоастероидная оборона густого пояса, обязательство перед дальней провинцией",
      "roles": [
        "piracy_suppression",
        "convoy_protection",
        "impact_defence",
        "alliance_obligation"
      ]
    },
    "gj832_tianhe": {
      "why": "крупнейшая потребность в летучих, карантин Гайи-Прайм и «кордонный флот»; спор двух китайских линий о первенстве",
      "roles": [
        "quarantine",
        "infrastructure_defence",
        "deterrence"
      ]
    },
    "hd20794_newindia": {
      "why": "Война за воду 2580 и общая система со Хомстедом: охрана ледовых прав и водных конвоев",
      "roles": [
        "infrastructure_defence",
        "deterrence",
        "customs"
      ]
    },
    "lalande_mecca": {
      "why": "одна бедная система на двоих с Агорой, собственная математика прыжка вне стандарта Когниума, подозрения Цитадели; оборона хабитатов и обсерватории",
      "roles": [
        "infrastructure_defence",
        "deterrence",
        "strategic_industry"
      ]
    },
    "delta_pav_karma": {
      "why": "отказ от маяка и сети: режим держится на внутреннем контроле; холодная война с изгнанниками Свободной Кармы",
      "roles": [
        "internal_control",
        "deterrence",
        "impact_defence"
      ]
    },
    "proxima_outpost": {
      "why": "силовая олигархия вне сети маяков и ближайший сосед Земли: людская сила как идеология, двоевластие кланов, оборона от «Возвращения Земли»",
      "roles": [
        "regime_survival",
        "deterrence",
        "impact_defence"
      ]
    },
    "wolf359_citadel": {
      "why": "травма IRON-SHIELD-2 и паранойя: арсенальная верфь, архив-хранилище, нейтралитет, который продаётся за ресурсы",
      "roles": [
        "deterrence",
        "strategic_industry",
        "intelligence"
      ]
    },
    "hd40307_maland": {
      "why": "холодная война с Небесной Твердыней (стычка 2680), автономный рой CD-2 во внешней системе",
      "roles": [
        "deterrence",
        "infrastructure_defence",
        "SAR"
      ]
    },
    "eps_eri_strife": {
      "why": "кланы живут контрактами и пиратством; частные охраны рудников, рейды против Гармонии",
      "roles": [
        "clan_defence",
        "raiding"
      ]
    },
    "lalande_hellas": {
      "why": "живёт транзитом: таможня, защита нейтральной торговли, напряжённый мир с Таурангой",
