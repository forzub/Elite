-
-    // Противоположная сторона тоже должна быть видна, но слабее.
-    float antiCenter = exp(-pow((abs(longitude) - PI) / 0.75, 2.0));
-
-    // Шумовые координаты вдоль галактического пояса.
-    vec2 galUv = vec2(
-        longitude / PI * 3.0,
