-    const glm::dvec3 screenRightWorld =
-        safeNormalizeD(
-            progradeWorld *
-                yawCos -
-            normalWorld *
-                yawSin,
-            progradeWorld
-        );
-
-    const glm::dvec3 screenUpWorld =
-        safeNormalizeD(
-            -normalWorld *
-                yawCos -
-            progradeWorld *
-                yawSin,
