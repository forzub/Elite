-glm::mat3
-SystemMapRenderer::hubCameraToParentPlanetBodyMatrix(
-    const world::celestial::HubMapSnapshot& hub
-) const
-{
-    /*
-    ====================================================
-    1. Текущая серверная орбитальная система хаба
